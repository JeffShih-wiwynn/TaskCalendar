:80 {
  encode zstd gzip

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /auth/* {
    reverse_proxy backend:8000
  }

  handle /admin/* {
    reverse_proxy backend:8000
  }

  handle /backup/* {
    reverse_proxy backend:8000
  }

  handle /health {
    reverse_proxy backend:8000
  }

  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle /sw.js {
    root * /srv
    header Cache-Control "no-cache"
    file_server
  }

  handle /registerSW.js {
    root * /srv
    header Cache-Control "no-cache"
    file_server
  }

  handle /manifest.webmanifest {
    root * /srv
    header Cache-Control "no-cache"
    file_server
  }

  handle {
    root * /srv
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
